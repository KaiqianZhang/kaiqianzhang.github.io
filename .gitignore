# docs/ is the generated site. It is deliberately NOT ignored: GitHub Pages
# serves it from the main branch, so it has to be committed. Never edit it by
# hand -- it is deleted and rebuilt by every `python3 build.py`.

__pycache__/
*.pyc
.DS_Store
# Sync-client conflict copies. build.py deletes and recreates docs/ on every
# build; a file-sync client (iCloud, Dropbox) sees that as a conflict and
# leaves "index 2.html", ".nojekyll 2" and friends behind. They are stale
# generated output, never worth committing, and `git add -A` would sweep
# them in. Scoped to docs/ so a legitimately named figure elsewhere -- say
# "Figure 2.png" -- is unaffected.
docs/**/* [0-9]
docs/**/* [0-9].*
docs/* [0-9]
docs/* [0-9].*

# Wrangler writes account id/name into this cache on every deploy. Generated,
# never useful to anyone else, and not something to publish.
worker/.wrangler/
